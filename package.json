{
  "name": "ranked.vote",
  "description": "Detailed reports on ranked-choice elections",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "RANKED_VOTE_DB=report_pipeline/reports.sqlite3 vite dev",
    "prebuild": "svelte-kit sync",
    "build": "RANKED_VOTE_DB=report_pipeline/reports.sqlite3 vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "generate-images": "bun scripts/generate-share-images.mjs",
    "report": "bun scripts/preprocess.ts",
    "report:migrate-strict": "bun scripts/migrate-db-to-strict.ts",
    "report:extract": "cd report_pipeline && ./extract-from-archives.sh",
    "report:notes": "bun scripts/sync-report-notes.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:ci": "bun test --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@sveltejs/adapter-static": "^4.0.1",
    "@sveltejs/kit": "^3.4.0",
    "better-sqlite3": "^13.2.0",
    "exceljs": "^4.4.0",
    "tippy.js": "^6.3.7",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "puppeteer": "^25.18.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8"
  },
  "trustedDependencies": [
    "esbuild",
    "puppeteer"
  ]
}
